{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KCE Creator OS — Content Idea",
  "description": "Canonical contract for transforming an approved content opportunity into a concrete content proposal.",
  "type": "object",

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },

    "idea_id": {
      "type": "string",
      "minLength": 1
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "idea_version": {
      "type": "string",
      "minLength": 1
    },

    "source": {
      "type": "object",
      "properties": {
        "opportunity_id": {
          "type": "string",
          "minLength": 1
        },

        "signal_id": {
          "type": "string",
          "minLength": 1
        }
      },

      "required": [
        "opportunity_id",
        "signal_id"
      ],

      "additionalProperties": false
    },

    "target": {
      "type": "object",
      "properties": {
        "brand_id": {
          "type": "string",
          "minLength": 1
        },

        "channel": {
          "type": "string",
          "minLength": 1
        },

        "platform": {
          "type": "string",
          "minLength": 1
        }
      },

      "required": [
        "brand_id",
        "channel",
        "platform"
      ],

      "additionalProperties": false
    },

    "concept": {
      "type": "object",
      "properties": {
        "working_title": {
          "type": "string",
          "minLength": 1
        },

        "hook": {
          "type": "string",
          "minLength": 1
        },

        "core_promise": {
          "type": "string",
          "minLength": 1
        },

        "angle": {
          "type": "string",
          "minLength": 1
        },

        "format": {
          "type": "string",
          "minLength": 1
        },

        "estimated_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },

        "content_pillar": {
          "type": "string",
          "minLength": 1
        }
      },

      "required": [
        "working_title",
        "hook",
        "core_promise",
        "angle",
        "format",
        "estimated_duration_seconds",
        "content_pillar"
      ],

      "additionalProperties": false
    },

    "audience": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },

        "audience_need": {
          "type": "string",
          "minLength": 1
        },

        "expected_value": {
          "type": "string",
          "minLength": 1
        }
      },

      "required": [
        "target",
        "audience_need",
        "expected_value"
      ],

      "additionalProperties": false
    },

    "creative_direction": {
      "type": "object",
      "properties": {
        "storytelling_approach": {
          "type": "string",
          "minLength": 1
        },

        "visual_direction": {
          "type": "string",
          "minLength": 1
        },

        "voice_direction": {
          "type": "string",
          "minLength": 1
        },

        "key_elements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },

      "required": [
        "storytelling_approach",
        "visual_direction",
        "voice_direction",
        "key_elements"
      ],

      "additionalProperties": false
    },

    "production": {
      "type": "object",
      "properties": {
        "complexity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "very_high"
          ]
        },

        "estimated_production_hours": {
          "type": "number",
          "minimum": 0
        },

        "required_assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },

        "ai_assistance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },

      "required": [
        "complexity",
        "estimated_production_hours",
        "required_assets",
        "ai_assistance"
      ],

      "additionalProperties": false
    },

    "processing": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "processed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },

      "required": [
        "status",
        "confidence"
      ],

      "additionalProperties": false
    }
  },

  "required": [
    "schema_version",
    "idea_id",
    "created_at",
    "idea_version",
    "source",
    "target",
    "concept",
    "audience",
    "creative_direction",
    "production",
    "processing"
  ],

  "additionalProperties": false
}