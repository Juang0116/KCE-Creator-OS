{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/thumbnail.schema.json",
  "title": "KCE Creator OS - Thumbnail Plan",
  "description": "Schema for thumbnail planning generated from content and production context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thumbnail_plan_id",
    "created_at",
    "thumbnail_plan_version",
    "source",
    "target",
    "thumbnail",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "thumbnail_plan_id": {
      "type": "string",
      "pattern": "^thumbnail_plan_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "thumbnail_plan_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_plan_id",
        "storyboard_id",
        "script_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "production_plan_id": {
          "type": "string"
        },
        "storyboard_id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thumbnail_id",
        "concept",
        "visual_direction",
        "text",
        "composition",
        "assets",
        "status"
      ],
      "properties": {
        "thumbnail_id": {
          "type": "string"
        },
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "visual_direction": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "composition": {
          "type": "string"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "generated",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}