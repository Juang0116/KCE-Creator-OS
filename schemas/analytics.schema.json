{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/analytics.schema.json",
  "title": "KCE Creator OS - Analytics Record",
  "description": "Schema for storing content performance analytics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analytics_id",
    "created_at",
    "analytics_version",
    "source",
    "target",
    "metrics",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "analytics_id": {
      "type": "string",
      "pattern": "^analytics_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "analytics_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publish_plan_id",
        "approval_id",
        "production_plan_id",
        "thumbnail_plan_id",
        "metadata_plan_id",
        "storyboard_id",
        "script_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "publish_plan_id": {
          "type": "string"
        },
        "approval_id": {
          "type": "string"
        },
        "production_plan_id": {
          "type": "string"
        },
        "thumbnail_plan_id": {
          "type": "string"
        },
        "metadata_plan_id": {
          "type": "string"
        },
        "storyboard_id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform",
        "content_id"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "content_id": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "impressions",
        "ctr",
        "watch_time_seconds",
        "average_view_duration_seconds",
        "likes",
        "comments",
        "shares",
        "subscribers_gained",
        "revenue"
      ],
      "properties": {
        "views": {
          "type": "integer",
          "minimum": 0
        },
        "impressions": {
          "type": "integer",
          "minimum": 0
        },
        "ctr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "watch_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "average_view_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "likes": {
          "type": "integer",
          "minimum": 0
        },
        "comments": {
          "type": "integer",
          "minimum": 0
        },
        "shares": {
          "type": "integer",
          "minimum": 0
        },
        "subscribers_gained": {
          "type": "integer",
          "minimum": 0
        },
        "revenue": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "collected",
            "validated",
            "review",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}