{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/learning.schema.json",
  "title": "Learning Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learning_id",
    "created_at",
    "learning_version",
    "source",
    "target",
    "insights",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "learning_id": {
      "type": "string",
      "pattern": "^learning_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "learning_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analytics_id",
        "publish_plan_id",
        "approval_id",
        "production_plan_id",
        "thumbnail_plan_id",
        "metadata_plan_id",
        "storyboard_id",
        "script_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "analytics_id": {
          "type": "string"
        },
        "publish_plan_id": {
          "type": "string"
        },
        "approval_id": {
          "type": "string"
        },
        "production_plan_id": {
          "type": "string"
        },
        "thumbnail_plan_id": {
          "type": "string"
        },
        "metadata_plan_id": {
          "type": "string"
        },
        "storyboard_id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform",
        "content_id"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "content_id": {
          "type": "string"
        }
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "insight_id",
          "category",
          "observation",
          "evidence",
          "confidence",
          "action"
        ],
        "properties": {
          "insight_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "performance",
              "audience",
              "content",
              "production",
              "distribution",
              "monetization"
            ]
          },
          "observation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "generated",
            "validated",
            "review",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}