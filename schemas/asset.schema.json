{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.dev/schemas/asset.schema.json",
  "title": "KCE Creator OS Asset Plan",
  "description": "Structured inventory of assets required for content production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_plan_id",
    "created_at",
    "asset_plan_version",
    "source",
    "target",
    "assets",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "asset_plan_id": {
      "type": "string",
      "pattern": "^asset_plan_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "asset_plan_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storyboard_id",
        "script_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "storyboard_id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "scene_id",
          "asset_type",
          "description",
          "purpose",
          "source_strategy",
          "priority",
          "status",
          "required"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "graphic",
              "screenshot",
              "background",
              "icon",
              "text",
              "audio",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "source_strategy": {
            "type": "string",
            "enum": [
              "generate",
              "retrieve",
              "capture",
              "create",
              "reuse"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "needed",
              "planned",
              "available",
              "acquired",
              "approved",
              "rejected"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}