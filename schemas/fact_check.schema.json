{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/fact_check.schema.json",
  "title": "Fact Check",
  "description": "Structured fact-checking contract for research findings and content claims.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "fact_check_id": {
      "type": "string",
      "pattern": "^fact_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string"
    },
    "fact_check_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      },
      "required": [
        "research_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "brand_id",
        "channel",
        "platform"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "verified",
              "partially_verified",
              "unverified",
              "refuted",
              "conflicting"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "claim",
          "evidence",
          "source_ids",
          "verification_status",
          "confidence",
          "notes"
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_claims": {
          "type": "integer",
          "minimum": 0
        },
        "verified_claims": {
          "type": "integer",
          "minimum": 0
        },
        "partially_verified_claims": {
          "type": "integer",
          "minimum": 0
        },
        "unverified_claims": {
          "type": "integer",
          "minimum": 0
        },
        "refuted_claims": {
          "type": "integer",
          "minimum": 0
        },
        "conflicting_claims": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "total_claims",
        "verified_claims",
        "partially_verified_claims",
        "unverified_claims",
        "refuted_claims",
        "conflicting_claims"
      ]
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "checking",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "confidence",
        "processed_at"
      ]
    }
  },
  "required": [
    "schema_version",
    "fact_check_id",
    "created_at",
    "fact_check_version",
    "source",
    "target",
    "checks",
    "summary",
    "processing"
  ]
}