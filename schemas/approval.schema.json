{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/approval.schema.json",
  "title": "KCE Creator OS - Approval Plan",
  "description": "Schema for human approval of content prepared for publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "created_at",
    "approval_version",
    "source",
    "target",
    "checks",
    "decision",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^approval_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_plan_id",
        "qa_report_id",
        "thumbnail_plan_id",
        "metadata_plan_id",
        "storyboard_id",
        "script_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "production_plan_id": {
          "type": "string"
        },
        "qa_report_id": {
          "type": "string"
        },
        "thumbnail_plan_id": {
          "type": "string"
        },
        "metadata_plan_id": {
          "type": "string"
        },
        "storyboard_id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qa_passed",
        "thumbnail_ready",
        "metadata_ready",
        "required_assets_ready",
        "approval_required"
      ],
      "properties": {
        "qa_passed": {
          "type": "boolean"
        },
        "thumbnail_ready": {
          "type": "boolean"
        },
        "metadata_ready": {
          "type": "boolean"
        },
        "required_assets_ready": {
          "type": "boolean"
        },
        "approval_required": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "changes_requested"
          ]
        },
        "reason": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}