{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KCE Creator OS — Opportunity",
  "description": "Canonical contract for evaluating content opportunities from radar signals.",
  "type": "object",

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },

    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "opportunity_version": {
      "type": "string",
      "minLength": 1
    },

    "source": {
      "type": "object",
      "properties": {
        "signal_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "signal_id"
      ],
      "additionalProperties": false
    },

    "target": {
      "type": "object",
      "properties": {
        "brand_id": {
          "type": "string",
          "minLength": 1
        },

        "channel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "brand_id",
        "channel"
      ],
      "additionalProperties": false
    },

    "scoring": {
      "type": "object",
      "properties": {
        "relevance": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },

        "audience_fit": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },

        "trend_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },

        "novelty": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },

        "production_feasibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },

        "evergreen_potential": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },

        "total_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },

      "required": [
        "relevance",
        "audience_fit",
        "trend_strength",
        "novelty",
        "production_feasibility",
        "evergreen_potential",
        "total_score"
      ],

      "additionalProperties": false
    },

    "analysis": {
      "type": "object",
      "properties": {
        "why_now": {
          "type": "string",
          "minLength": 1
        },

        "why_this_brand": {
          "type": "string",
          "minLength": 1
        },

        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },

        "recommendation": {
          "type": "string",
          "enum": [
            "strong_candidate",
            "candidate",
            "weak_candidate",
            "reject"
          ]
        }
      },

      "required": [
        "why_now",
        "why_this_brand",
        "risks",
        "recommendation"
      ],

      "additionalProperties": false
    },

    "processing": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "evaluated",
            "approved",
            "rejected",
            "archived"
          ]
        },

        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "processed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },

      "required": [
        "status",
        "confidence"
      ],

      "additionalProperties": false
    }
  },

  "required": [
    "schema_version",
    "opportunity_id",
    "created_at",
    "opportunity_version",
    "source",
    "target",
    "scoring",
    "analysis",
    "processing"
  ],

  "additionalProperties": false
}