{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.dev/schemas/voice.schema.json",
  "title": "KCE Creator OS Voice Plan",
  "description": "Structured voice and narration plan generated from a content script.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "voice_plan_id",
    "created_at",
    "voice_plan_version",
    "source",
    "target",
    "voice_profile",
    "segments",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "voice_plan_id": {
      "type": "string",
      "pattern": "^voice_plan_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "voice_plan_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_id",
        "storyboard_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "script_id": {
          "type": "string"
        },
        "storyboard_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "voice_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice_id",
        "language",
        "tone",
        "style",
        "gender",
        "age_range"
      ],
      "properties": {
        "voice_id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "age_range": {
          "type": "string"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "section_id",
          "text",
          "language",
          "emotion",
          "delivery",
          "estimated_duration_seconds",
          "status"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "emotion": {
            "type": "string"
          },
          "delivery": {
            "type": "string"
          },
          "estimated_duration_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "generated",
              "approved",
              "rejected"
            ]
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}