{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.dev/schemas/storyboard.schema.json",
  "title": "KCE Creator OS Storyboard",
  "description": "Structured visual storyboard generated from a content script.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "storyboard_id",
    "created_at",
    "storyboard_version",
    "source",
    "target",
    "metadata",
    "scenes",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "storyboard_id": {
      "type": "string",
      "pattern": "^storyboard_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "storyboard_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_id",
        "idea_id",
        "research_id",
        "fact_check_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "research_id": {
          "type": "string"
        },
        "fact_check_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "format",
        "estimated_duration_seconds",
        "scene_count"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "estimated_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "scene_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "section_id",
          "narration",
          "visual_direction",
          "shot_type",
          "visual_assets",
          "on_screen_text",
          "transition",
          "estimated_duration_seconds"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "visual_direction": {
            "type": "string"
          },
          "shot_type": {
            "type": "string"
          },
          "visual_assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "on_screen_text": {
            "type": "string"
          },
          "transition": {
            "type": "string"
          },
          "estimated_duration_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}