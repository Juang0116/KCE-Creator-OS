{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Plan",
  "type": "object",
  "required": [
    "schema_version",
    "production_plan_id",
    "created_at",
    "production_plan_version",
    "source",
    "target",
    "timeline",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "production_plan_id": {
      "type": "string",
      "pattern": "^production_plan_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string"
    },
    "production_plan_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "storyboard_id",
        "asset_plan_id",
        "voice_plan_id",
        "music_sfx_plan_id",
        "script_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "storyboard_id": {
          "type": "string"
        },
        "asset_plan_id": {
          "type": "string"
        },
        "voice_plan_id": {
          "type": "string"
        },
        "music_sfx_plan_id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "brand_id",
        "channel",
        "platform"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timeline_id",
          "scene_id",
          "start_time_seconds",
          "end_time_seconds",
          "asset_ids",
          "voice_segment_ids",
          "music_sfx_track_ids",
          "transition",
          "status"
        ],
        "properties": {
          "timeline_id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "start_time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "voice_segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "music_sfx_track_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "transition": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "ready",
              "in_progress",
              "rendered",
              "approved",
              "rejected"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "processing": {
      "type": "object",
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}