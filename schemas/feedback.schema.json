{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/feedback.schema.json",
  "title": "Feedback Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feedback_id",
    "created_at",
    "feedback_version",
    "source",
    "target",
    "actions",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "const": 1.0
    },
    "feedback_id": {
      "type": "string",
      "pattern": "^feedback_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "feedback_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_id",
        "analytics_id",
        "opportunity_id",
        "idea_id",
        "signal_id"
      ],
      "properties": {
        "learning_id": {
          "type": "string"
        },
        "analytics_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform",
        "content_id"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "content_id": {
          "type": "string"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "type",
          "reason",
          "priority",
          "status"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "reinforce",
              "experiment",
              "review",
              "avoid",
              "collect_more_data"
            ]
          },
          "reason": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "rejected",
              "applied"
            ]
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "generated",
            "validated",
            "review",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}