{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/script.schema.json",
  "title": "Content Script",
  "description": "Structured script contract generated from a content idea, research and fact check.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "script_id": {
      "type": "string",
      "pattern": "^script_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string"
    },
    "script_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idea_id": {
          "type": "string"
        },
        "research_id": {
          "type": "string"
        },
        "fact_check_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      },
      "required": [
        "idea_id",
        "research_id",
        "fact_check_id",
        "opportunity_id",
        "signal_id"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "brand_id",
        "channel",
        "platform"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "estimated_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "content_pillar": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "format",
        "estimated_duration_seconds",
        "content_pillar",
        "tone"
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narration": {
          "type": "string"
        },
        "visual_direction": {
          "type": "string"
        }
      },
      "required": [
        "narration",
        "visual_direction"
      ]
    },
    "introduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narration": {
          "type": "string"
        },
        "visual_direction": {
          "type": "string"
        }
      },
      "required": [
        "narration",
        "visual_direction"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim": {
                  "type": "string"
                },
                "fact_check_id": {
                  "type": "string"
                },
                "verification_status": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "partially_verified",
                    "unverified",
                    "refuted",
                    "conflicting"
                  ]
                }
              },
              "required": [
                "claim",
                "fact_check_id",
                "verification_status"
              ]
            }
          },
          "visual_direction": {
            "type": "string"
          },
          "transition": {
            "type": "string"
          }
        },
        "required": [
          "section_id",
          "title",
          "narration",
          "claims",
          "visual_direction",
          "transition"
        ]
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narration": {
          "type": "string"
        },
        "visual_direction": {
          "type": "string"
        }
      },
      "required": [
        "narration",
        "visual_direction"
      ]
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narration": {
          "type": "string"
        },
        "visual_direction": {
          "type": "string"
        }
      },
      "required": [
        "narration",
        "visual_direction"
      ]
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "confidence",
        "processed_at"
      ]
    }
  },
  "required": [
    "schema_version",
    "script_id",
    "created_at",
    "script_version",
    "source",
    "target",
    "metadata",
    "hook",
    "introduction",
    "sections",
    "conclusion",
    "cta",
    "processing"
  ]
}