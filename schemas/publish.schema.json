{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/publish.schema.json",
  "title": "KCE Creator OS - Publish Plan",
  "description": "Schema for preparing approved content for publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publish_plan_id",
    "created_at",
    "publish_plan_version",
    "source",
    "target",
    "publication",
    "processing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "publish_plan_id": {
      "type": "string",
      "pattern": "^publish_plan_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "publish_plan_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "production_plan_id",
        "thumbnail_plan_id",
        "metadata_plan_id",
        "storyboard_id",
        "script_id",
        "idea_id",
        "opportunity_id",
        "signal_id"
      ],
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "production_plan_id": {
          "type": "string"
        },
        "thumbnail_plan_id": {
          "type": "string"
        },
        "metadata_plan_id": {
          "type": "string"
        },
        "storyboard_id": {
          "type": "string"
        },
        "script_id": {
          "type": "string"
        },
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_id",
        "channel",
        "platform"
      ],
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "keywords",
        "category",
        "cta",
        "language",
        "visibility",
        "scheduled_at",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "unlisted",
            "public"
          ]
        },
        "scheduled_at": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "blocked",
            "ready",
            "scheduled",
            "published",
            "failed"
          ]
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "processed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}