{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kce-labs.local/schemas/research_brief.schema.json",
  "title": "Research Brief",
  "description": "Structured research contract for a content idea.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "research_id": {
      "type": "string",
      "pattern": "^research_[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string"
    },
    "research_version": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idea_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "signal_id": {
          "type": "string"
        }
      },
      "required": [
        "idea_id",
        "opportunity_id",
        "signal_id"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "required": [
        "brand_id",
        "channel",
        "platform"
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research_question": {
          "type": "string"
        },
        "content_goal": {
          "type": "string"
        },
        "key_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "research_question",
        "content_goal",
        "key_questions"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "topics",
        "keywords",
        "exclusions"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "claim",
          "evidence",
          "source_id",
          "confidence"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "reliability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "source_id",
          "title",
          "url",
          "publisher",
          "source_type",
          "reliability"
        ]
      }
    },
    "research_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "researching",
            "review",
            "approved",
            "rejected",
            "archived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "confidence",
        "processed_at"
      ]
    }
  },
  "required": [
    "schema_version",
    "research_id",
    "created_at",
    "research_version",
    "source",
    "target",
    "objective",
    "scope",
    "findings",
    "sources",
    "research_gaps",
    "processing"
  ]
}